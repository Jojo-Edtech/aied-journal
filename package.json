{
  "name": "aied-journal-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:local": "node scripts/build-local-data.mjs",
    "check:data-loader": "node --test scripts/data-loader.test.mjs",
    "check:catalog-ui": "node --test scripts/catalog-ui.test.mjs",
    "check:catalog": "python3 -m unittest discover -s scripts -p 'test_catalog_import.py'",
    "check:scope": "python3 -m unittest discover -s scripts -p 'test_journal_scope.py'",
    "check:pipeline": "python3 -m unittest discover -s scripts -p 'test_radar_pipeline.py'",
    "check:worker": "node --test journal_worker/index.test.mjs",
    "build:static": "node scripts/build-static-site.mjs",
    "check:api-security": "python3 -m unittest research_radar_api/test_security.py research_radar_api/test_catalog_retrieval.py research_radar_api/test_scope.py",
    "radar:generate": "python3 scripts/generate-research-radar.py",
    "postradar:generate": "npm run prepare:local",
    "radar:generate:quick": "python3 scripts/generate-research-radar.py --skip-crawl",
    "postradar:generate:quick": "npm run prepare:local",
    "sanitize:public": "node scripts/sanitize-public-data.mjs",
    "postsanitize:public": "npm run prepare:local",
    "validate:data": "node scripts/validate-data.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
