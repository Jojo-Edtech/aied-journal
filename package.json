{
  "name": "aied-journal-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:static": "node scripts/build-static-site.mjs",
    "check:api-security": "python3 -m unittest research_radar_api/test_security.py",
